# /etc/agent-harness/env — non-secret deployment settings (EnvironmentFile for the systemd unit).
# secrets normally come from aws secrets manager (AGENT_HARNESS_SECRETS_{ENV}) via the instance role.
# for a no-aws single-box install you can instead put the secret env vars here directly
# (SLACK_BOT_TOKEN, GITHUB_APP_ID, REVIEWER_GITHUB_APP_ID, ... — see agent_harness/secrets.py);
# this file is root-owned mode 640 so only root and the service user can read it.
ENVIRONMENT=staging
AGENT_HARNESS_DB_PATH=/var/lib/agent-harness/agent-harness.db
AGENT_HARNESS_CONFIG_PATH=/etc/agent-harness/config.yaml
AGENT_HARNESS_WORKSPACES_ROOT=/var/lib/agent-harness/workspaces
AGENT_HARNESS_REPOS_ROOT=/var/lib/agent-harness/repos
AGENT_HARNESS_MEMORY_ROOT=/var/lib/agent-harness/memory
AGENT_HARNESS_SKILLS_ROOT=/opt/agent-harness/skills
AGENT_HARNESS_UI_DIST=/opt/agent-harness/ui/dist
AGENT_HARNESS_BROKER_SOCKET=/run/agent-harness/broker.sock
AGENT_HARNESS_REVIEWER_BROKER_SOCKET=/run/agent-harness/broker-reviewer.sock
AGENT_HARNESS_GIT_CRED_HELPER=/opt/agent-harness/deploy/git-cred-helper.py
AWS_REGION=us-east-1
