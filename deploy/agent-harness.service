[Unit]
Description=agent-harness orchestrator
After=network-online.target
Wants=network-online.target

[Service]
User=agentharness
Group=agentharness
WorkingDirectory=/opt/agent-harness
EnvironmentFile=/etc/agent-harness/env
ExecStart=/opt/agent-harness/.venv/bin/python -m agent_harness.main
# restarts are safe by design: reconciliation requeues and resumes interrupted tasks
Restart=on-failure
RestartSec=5
# invalid config exits 64: stop instead of crash-looping
RestartPreventExitStatus=64
TimeoutStopSec=90
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
