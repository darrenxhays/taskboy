# /etc/taskboy/env — non-secret deployment settings (EnvironmentFile for the systemd unit).
# secrets normally come from aws secrets manager (TASKBOY_SECRETS_{ENV}) via the instance role.
# for a no-aws single-box install you can instead put the secret env vars here directly
# (SLACK_BOT_TOKEN, GITHUB_APP_ID, REVIEWER_GITHUB_APP_ID, ... — see taskboy/secrets.py);
# this file is root-owned mode 640 so only root and the service user can read it.
ENVIRONMENT=staging
TASKBOY_DB_PATH=/var/lib/taskboy/taskboy.db
TASKBOY_CONFIG_PATH=/etc/taskboy/config.yaml
TASKBOY_WORKSPACES_ROOT=/var/lib/taskboy/workspaces
TASKBOY_REPOS_ROOT=/var/lib/taskboy/repos
TASKBOY_MEMORY_ROOT=/var/lib/taskboy/memory
TASKBOY_SKILLS_ROOT=/opt/taskboy/skills
TASKBOY_BROKER_SOCKET=/run/taskboy/broker.sock
TASKBOY_REVIEWER_BROKER_SOCKET=/run/taskboy/broker-reviewer.sock
# the dashboard ui and git credential helper ship inside the installed package; override
# TASKBOY_UI_DIST / TASKBOY_GIT_CRED_HELPER here only to point elsewhere
AWS_REGION=us-east-1
